# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Jellyfin connection (required)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_jellyfin_api_key

# Seerr / Jellyseerr connection (required)
SEERR_URL=http://seerr:5055
SEERR_API_KEY=your_seerr_api_key

# Default Discord webhook URL (required if using POST /webhook, /webhook/sonarr, /webhook/radarr;
# optional if using drop-in proxy route POST /api/webhooks/:id/:token)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional comma-separated allowlist of Discord webhook IDs permitted on /api/webhooks/:id/:token
# Leave empty to allow any webhook ID on the proxy route
ALLOWED_DISCORD_WEBHOOK_IDS=

# How often (in seconds) to poll Jellyfin users/favourites and Seerr Discord connections
POLL_INTERVAL_SECONDS=300

# Debounce window (in seconds) per (media, discordUser) to avoid ping spam during episode flurries
# Default: 3600 (1 hour)
PING_DEBOUNCE_SECONDS=3600

# Short aggregation window (in seconds) to batch rapid bursts of webhook embeds into a single Discord post
# Set to 0 to forward immediately without batching
AGGREGATION_WINDOW_SECONDS=10

# Comma-separated media update categories that trigger user pings
# Supported: added, upgraded, deleted, grab
PING_ON_EVENTS=added,upgraded,deleted

# Optional prefix text before injected user mentions (e.g. "Favourited update:")
PING_PREFIX=
